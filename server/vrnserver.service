# systemd unit for the VRN server.
#   sudo useradd -r -s /usr/sbin/nologin vrn
#   sudo install -o vrn -d /opt/vrnserver /var/lib/vrnserver
#   sudo cp vrnserver-<ver>-linux-amd64 /opt/vrnserver/vrnserver && sudo chmod +x /opt/vrnserver/vrnserver
#   sudo cp vrnserver.yaml /opt/vrnserver/      (storage.dir: /var/lib/vrnserver)
#   sudo cp vrnserver.service /etc/systemd/system/ && sudo systemctl enable --now vrnserver
[Unit]
Description=VRN server
After=network-online.target
Wants=network-online.target

[Service]
User=vrn
WorkingDirectory=/opt/vrnserver
ExecStart=/opt/vrnserver/vrnserver -config /opt/vrnserver/vrnserver.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
